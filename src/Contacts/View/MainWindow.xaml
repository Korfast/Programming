<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contacts" Height="350" Width="600">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: Edit Contact в GroupBox -->
        <GroupBox Grid.Row="0" Grid.Column="0" 
                  Header="Edit Contact" 
                  Margin="0,0,3,0" 
                  Padding="0">
            <StackPanel>
                <Label Content="Name:" Margin="3" Padding="0"/>
                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="3" Padding="0"/>
                <Label Content="Phone Number:" Margin="3" Padding="0"/>
                <TextBox Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                         Margin="3" Padding="0"/>
                <Label Content="Email:" Margin="3" Padding="0"/>
                <TextBox Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="3" Padding="0"/>
            </StackPanel>
        </GroupBox>

        <!-- Правая панель: Read Contact в GroupBox -->
        <GroupBox Grid.Row="0" Grid.Column="1" 
                  Header="Read Contact" 
                  Margin="3,0,0,0" 
                  Padding="0">
            <StackPanel>
                <Label Content="Name:" Margin="3" Padding="0"/>
                <TextBlock Text="{Binding Name}" Margin="3" Padding="0" FontWeight="Bold"/>
                <Label Content="Phone Number:" Margin="3" Padding="0"/>
                <TextBlock Text="{Binding PhoneNumber}" Margin="3" Padding="0" FontWeight="Bold"/>
                <Label Content="Email:" Margin="3" Padding="0"/>
                <TextBlock Text="{Binding Email}" Margin="3" Padding="0" FontWeight="Bold"/>
            </StackPanel>
        </GroupBox>

        <!-- Кнопки Save/Load, расположенные вне панелей, прижаты к правому краю -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,10,0,0">
            <Button Content="Save" Width="75" Height="25" Margin="3" 
                    Command="{Binding SaveCommand}"/>
            <Button Content="Load" Width="75" Height="25" Margin="3" 
                    Command="{Binding LoadCommand}"/>
        </StackPanel>
    </Grid>
</Window>