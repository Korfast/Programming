<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contacts" Height="450" Width="700">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- Левая колонка -->
        <Grid Grid.Column="0" Background="#f8f8f8">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Поле поиска -->
                <Grid Grid.Row="0" Margin="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Find:" Margin="0,0,3,0" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="3"/>
                </Grid>

                <!-- Список контактов -->
                <ListBox Grid.Row="1" ItemsSource="{Binding Contacts}" 
                         SelectedItem="{Binding SelectedContact}" Margin="0,3,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Margin="3"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Кнопки -->
                <Grid Grid.Row="2" Margin="0,3,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Add" Height="25" Margin="0,3,3,3" 
            Command="{Binding AddCommand}" IsEnabled="{Binding IsAddEditRemoveEnabled}"/>
                    <Button Grid.Column="1" Content="Edit" Height="25" Margin="3,3,3,3" 
            Command="{Binding EditCommand}" IsEnabled="{Binding IsEditRemoveEnabled}"/>
                    <Button Grid.Column="2" Content="Remove" Height="25" Margin="3,3,0,3" 
            Command="{Binding RemoveCommand}" IsEnabled="{Binding IsEditRemoveEnabled}"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Разделитель -->
        <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" Background="White"/>

        <!-- Правая колонка -->
        <Grid Grid.Column="2" Background="White">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- метка Name -->
                    <RowDefinition Height="Auto"/>
                    <!-- поле Name + фото -->
                    <RowDefinition Height="Auto"/>
                    <!-- метка Phone -->
                    <RowDefinition Height="Auto"/>
                    <!-- поле Phone -->
                    <RowDefinition Height="Auto"/>
                    <!-- метка Email -->
                    <RowDefinition Height="Auto"/>
                    <!-- поле Email -->
                    <RowDefinition Height="Auto"/>
                    <!-- кнопка Apply -->
                </Grid.RowDefinitions>

                <!-- Метка Name -->
                <Label Grid.Row="0" Grid.Column="1" Content="Name:" Margin="3" VerticalAlignment="Center"/>

                <!-- Фото (находится в строке с полем Name) -->
                <Border Grid.Row="1" Grid.Column="0" Grid.RowSpan="5" Width="100" Height="100" 
                Background="LightGray" Margin="3" VerticalAlignment="Top">
                    <TextBlock Text="Photo" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Поле ввода Name (в той же строке, что и фото) -->
                <TextBox Grid.Row="1" Grid.Column="1" 
                 Text="{Binding CurrentContact.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 IsReadOnly="{Binding IsReadOnly}" Margin="3" Padding="3"/>

                <!-- Метка Phone -->
                <Label Grid.Row="2" Grid.Column="1" Content="Phone Number:" Margin="3" VerticalAlignment="Center"/>

                <!-- Поле Phone -->
                <TextBox Grid.Row="3" Grid.Column="1" 
                 Text="{Binding CurrentContact.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 IsReadOnly="{Binding IsReadOnly}" Margin="3" Padding="3"/>

                <!-- Метка Email -->
                <Label Grid.Row="4" Grid.Column="1" Content="Email:" Margin="3" VerticalAlignment="Center"/>

                <!-- Поле Email -->
                <TextBox Grid.Row="5" Grid.Column="1" 
                 Text="{Binding CurrentContact.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 IsReadOnly="{Binding IsReadOnly}" Margin="3" Padding="3"/>

                <!-- Кнопка Apply -->
                <Button Grid.Row="6" Grid.Column="1" Content="Apply" Width="75" Height="25"
                Command="{Binding ApplyCommand}" HorizontalAlignment="Left" Margin="0,50,0,0"
                Visibility="{Binding IsApplyVisible, Converter={StaticResource BooleanToVisibility}}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>